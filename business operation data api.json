    {
      "parameters": {
        "jsCode": "const requestLog = $('request log sheet').all().map(i => i.json);\nconst invoices = $('Invoice sheet').all().map(i => i.json);\nconst flagged = $('flagged invoices').all().map(i => i.json);\n\nconst today = new Date().toISOString().split('T')[0];\n\nconst totalRequests = requestLog.length + invoices.length + flagged.length;\nconst processing = requestLog.filter(r => r.status === 'Processing').length;\nconst completed = requestLog.filter(r => r.status === 'Completed').length;\nconst requiresAttention = requestLog.filter(r => r.attention === 'true' || r.attention === true).length + flagged.length;\nconst requestsToday = requestLog.filter(r => (r.created_at || '').startsWith(today)).length;\n\nconst queue = requestLog.map(r => ({\n  request: r.summary || r.order_number || r.request_id,\n  type: r.type,\n  status: r.status,\n  priority: r.priority\n}));\n\nreturn [{\n  json: {\n    overview: {\n      totalRequests: totalRequests,\n      processing: processing,\n      completed: completed,\n      requiresAttention: requiresAttention,\n      requestsToday: requestsToday\n    },\n    queue: queue\n  }\n}];"
      },
